# ---------------------------------------------------------------------------
# DIAD Signs – deployment configuration. Copy to .env.local for local work.
# Nothing here is required for the owner demo: the defaults are SAFE (noindex).
# ---------------------------------------------------------------------------

# Canonical production origin. No trailing slash. Apex is the current decision
# (the live WordPress site already redirects www -> apex). Confirm before launch.
NEXT_PUBLIC_SITE_URL=https://diadsigns.co.za

# LAUNCH SWITCH. Leave unset/false for the owner demo and every preview.
# BEFORE setting true: clear the launch blockers at the top of
# docs/seo/SEO-FOUNDATION.md – incl. linking this site on Google Business Profile.
# Indexing also requires VERCEL_ENV=production and a non-vercel.app https origin.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Google Search Console HTML-tag verification token (content value only).
# Prefer DNS verification of the domain property at Xneelo instead.
GOOGLE_SITE_VERIFICATION=

# Analytics – set ONE, only after the POPIA consent approach is agreed.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
